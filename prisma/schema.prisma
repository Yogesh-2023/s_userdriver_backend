generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum DriverVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  BUSY
}

enum VehicleStatus {
  PENDING
  ACTIVE
  INACTIVE
  IN_SERVICE
  MAINTENANCE
  SUSPENDED
}

enum VehicleVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  PENDING
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  CANCELLED
  NO_DRIVER_FOUND
  PAYMENT_PENDING
  PAYMENT_COMPLETED
}

enum BookingType {
  IMMEDIATE
  SCHEDULED
}

enum RideType {
  CITY
  RENTAL
  OUTSTATION
}

enum TripType {
  ONE_WAY
  RETURN
}

enum TripLeg {
  OUTBOUND
  RETURN
}

enum DispatchOfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  INVALIDATED
}

enum DispatchCycleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

enum DriverAssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  TIMED_OUT
  ACTIVE
  COMPLETED
  RELEASED
  CANCELLED
}

enum TripStatus {
  CREATED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  WALLET
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentTransactionType {
  ORDER_CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUND
  WEBHOOK
  RECONCILIATION
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CouponDiscountType {
  FIXED
  PERCENTAGE
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum RatingSubjectType {
  CUSTOMER
  DRIVER
}

enum SosStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  FALSE_ALARM
  CLOSED
}

enum SosRequesterType {
  USER
  DRIVER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationCampaignStatus {
  QUEUED
  SCHEDULED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum ReportExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum ConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmergencyContactRelation {
  PARENT
  SPOUSE
  SIBLING
  FRIEND
  RELATIVE
  OTHER
}

enum NavigationPreference {
  GOOGLE_MAPS
  APPLE_MAPS
  IN_APP
}

enum DriverOnboardingStatus {
  ACCOUNT_CREATED
  PROFILE_PENDING
  PROFILE_COMPLETED
  KYC_PENDING
  KYC_UNDER_REVIEW
  KYC_APPROVED
  VEHICLE_PENDING
  VEHICLE_UNDER_REVIEW
  READY_TO_DRIVE
  REJECTED
  SUSPENDED
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  phone                   String                   @unique @db.VarChar(20)
  email                   String?                  @unique @db.VarChar(320)
  displayName             String?                  @db.VarChar(120)
  status                  UserStatus               @default(ACTIVE)
  phoneVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  customerProfile         CustomerProfile?
  driverProfile           DriverProfile?
  adminProfile            AdminProfile?
  roles                   UserRole[]
  sessions                Session[]
  deviceTokens            DeviceToken[]
  loginHistory            LoginHistory[]
  wallet                  Wallet?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  emergencyContacts       EmergencyContact[]       @relation("EmergencyContactOwner")
  createdSosRequests      SosRequest[]             @relation("SosCreatedBy")
  acknowledgedSosRequests SosRequest[]             @relation("SosAcknowledgedBy")
  sosMessages             EmergencySosMessage[]
  sosUserReads            SosUserMessageRead[]
  supportTickets          SupportTicket[]          @relation("SupportTicketCreator")
  supportMessages         SupportMessage[]
  supportMessageReads     SupportMessageRead[]
  performedAuditLogs      AuditLog[]               @relation("AuditActor")
  ratingsGiven            Rating[]                 @relation("RatingAuthor")
  ratingsReceived         Rating[]                 @relation("RatingSubject")
  reviewReports           ReviewReport[]

  // removed old index
  @@index([createdAt])
}

model CustomerProfile {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @unique @db.Uuid
  referralCode    String                  @unique @db.VarChar(20)
  dateOfBirth     DateTime?               @db.Date
  gender          Gender?
  profileImageUrl String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  couponUsages    CouponUsage[]
  referralsMade   Referral[]              @relation("ReferralReferrer")
  referralUsed    Referral?               @relation("ReferralReferred")
  statusHistory   CustomerStatusHistory[]
  addresses       CustomerAddress[]
  preferences     CustomerPreference?
  dataExports     DataExportRequest[]
  deletionRequest AccountDeletionRequest?
  attentionQueues AttentionQueue[]

  @@index([createdAt])
}

model DriverProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  licenseNumber   String?   @unique @db.VarChar(50)
  dateOfBirth     DateTime? @db.Date
  gender          Gender?
  profileImageUrl String?
  alternatePhone  String?   @db.VarChar(20)

  addressLine1 String?
  addressLine2 String?
  landmark     String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  drivingLicenseIssueDate  DateTime? @db.Date
  drivingLicenseExpiryDate DateTime? @db.Date
  drivingExperienceYears   Int?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation EmergencyContactRelation?

  preferredLanguage    String?
  navigationPreference NavigationPreference?
  serviceAreaId        String?               @db.Uuid

  onboardingStatus DriverOnboardingStatus @default(ACCOUNT_CREATED)

  verificationStatus  DriverVerificationStatus    @default(PENDING)
  availability        DriverAvailability          @default(OFFLINE)
  averageRating       Decimal                     @default(0) @db.Decimal(3, 2)
  totalTrips          Int                         @default(0)
  verifiedAt          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents           DriverDocument[]
  vehicleAssignments  DriverVehicleAssignment[]
  dispatchOffers      DispatchOffer[]
  currentBookings     Booking[]                   @relation("CurrentBookingDriver")
  assignments         DriverAssignment[]
  vehicles            Vehicle[]                   @relation("VehicleDriver")
  trips               Trip[]
  locations           DriverLocation[]
  statusHistory       DriverStatusHistory[]
  verificationHistory DriverVerificationHistory[]
  kycSubmissions      DriverKycSubmission[]
  subscriptions       DriverSubscription[]
  kycHistory          DriverKycStatusHistory[]
  availabilityHistory DriverAvailabilityHistory[]
  locationHistory     DriverLocationHistory[]
  wallet              DriverWallet?
  earnings            DriverEarning[]
  settlements         DriverSettlement[]
  payoutAccounts      DriverPayoutAccount[]
  incentiveProgress   DriverIncentiveProgress[]
  incentiveRewards    DriverIncentiveReward[]
  attentionQueues     AttentionQueue[]

  @@index([verificationStatus, availability])
  @@index([verificationStatus, createdAt])
}

model AdminProfile {
  id                          String                       @id @default(uuid()) @db.Uuid
  userId                      String                       @unique @db.Uuid
  title                       String?                      @db.VarChar(100)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerStatusChanges       CustomerStatusHistory[]
  driverStatusChanges         DriverStatusHistory[]
  driverVerificationChanges   DriverVerificationHistory[]
  vehicleStatusChanges        VehicleStatusHistory[]
  vehicleVerificationChanges  VehicleVerificationHistory[]
  pricingRulesCreated         PricingRule[]
  notificationTemplates       NotificationTemplate[]
  notificationCampaigns       NotificationCampaign[]
  reportExports               ReportExport[]
  assignedSupportTickets      SupportTicket[]              @relation("SupportAssignedAdmin")
  supportMessageReads         AdminSupportMessageRead[]
  assignedSosRequests         SosRequest[]                 @relation("SosAssignedAdmin")
  sosAdminReads               SosAdminMessageRead[]
  supportAssignmentsPerformed SupportAssignmentHistory[]   @relation("SupportAssignmentActor")
  supportAssignmentsReceived  SupportAssignmentHistory[]   @relation("SupportAssignmentTarget")
  supportAssignmentsPrevious  SupportAssignmentHistory[]   @relation("SupportAssignmentPrevious")
  supportStatusChanges        SupportStatusHistory[]
  supportCategoriesCreated    SupportCategory[]
  systemSettingsUpdated       SystemSetting[]
  systemSettingHistory        SystemSettingHistory[]
  adminNotes                  AdminNote[]
  credential                  AdminCredential?
  vehicleCategories           VehicleCategory[]
  sosActivities               SosActivity[]
  safetyIncidentNotes         SafetyIncidentNote[]
  documentStatusHistories     DocumentStatusHistory[]
}

model AdminCredential {
  id           String       @id @default(uuid()) @db.Uuid
  adminId      String       @unique @db.Uuid
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  admin        AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model CustomerStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String          @db.Uuid
  adminId    String          @db.Uuid
  fromStatus UserStatus
  toStatus   UserStatus
  reason     String
  createdAt  DateTime        @default(now())
  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  admin      AdminProfile    @relation(fields: [adminId], references: [id])

  @@index([customerId, createdAt])
  @@index([adminId, createdAt])
}

model DriverStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  driverId   String        @db.Uuid
  adminId    String        @db.Uuid
  fromStatus UserStatus
  toStatus   UserStatus
  reason     String
  createdAt  DateTime      @default(now())
  driver     DriverProfile @relation(fields: [driverId], references: [id])
  admin      AdminProfile  @relation(fields: [adminId], references: [id])

  @@index([driverId, createdAt])
  @@index([adminId, createdAt])
}

model DriverVerificationHistory {
  id         String                   @id @default(uuid()) @db.Uuid
  driverId   String                   @db.Uuid
  adminId    String                   @db.Uuid
  fromStatus DriverVerificationStatus
  toStatus   DriverVerificationStatus
  reason     String?
  createdAt  DateTime                 @default(now())
  driver     DriverProfile            @relation(fields: [driverId], references: [id])
  admin      AdminProfile             @relation(fields: [adminId], references: [id])

  @@index([driverId, createdAt])
  @@index([adminId, createdAt])
}

model VehicleStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  vehicleId  String        @db.Uuid
  adminId    String        @db.Uuid
  fromStatus VehicleStatus
  toStatus   VehicleStatus
  reason     String
  createdAt  DateTime      @default(now())
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id])
  admin      AdminProfile  @relation(fields: [adminId], references: [id])

  @@index([vehicleId, createdAt])
  @@index([adminId, createdAt])
}

model VehicleVerificationHistory {
  id         String                    @id @default(uuid()) @db.Uuid
  vehicleId  String                    @db.Uuid
  adminId    String                    @db.Uuid
  fromStatus VehicleVerificationStatus
  toStatus   VehicleVerificationStatus
  reason     String?
  createdAt  DateTime                  @default(now())
  vehicle    Vehicle                   @relation(fields: [vehicleId], references: [id])
  admin      AdminProfile              @relation(fields: [adminId], references: [id])

  @@index([vehicleId, createdAt])
  @@index([adminId, createdAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model OtpVerification {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String    @db.VarChar(20)
  purpose     String    @default("LOGIN") @db.VarChar(30)
  otpHash     String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  managementId String    @unique @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  deviceInfo   Json?
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  isRevoked    Boolean   @default(false)
  revokedAt    DateTime?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked, expiresAt])
  @@index([expiresAt])
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String   @db.VarChar(20)
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model VehicleCategory {
  id                      String              @id @default(uuid()) @db.Uuid
  slug                    String              @unique @default(dbgenerated("(gen_random_uuid())::character varying")) @db.VarChar(80)
  name                    String              @unique @db.VarChar(100)
  description             String?
  imageUrl                String?
  iconUrl                 String?
  minPassengers           Int?
  maxPassengers           Int?
  allowedFuelTypes        String[]
  isActive                Boolean             @default(true)
  displayOrder            Int                 @default(0)
  deletedAt               DateTime?
  createdByAdminId        String?             @db.Uuid
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  vehicles                Vehicle[]
  pricingRules            PricingRule[]
  surgeRules              SurgePricingRule[]
  bookings                Booking[]
  createdByAdmin          AdminProfile?       @relation(fields: [createdByAdminId], references: [id])
  coupons                 Coupon[]
  applicableSubscriptions SubscriptionPlan[]
  rentalPackages          RentalPackage[]
  outstationPricings      OutstationPricing[]
  vehicleModels           VehicleModel[]

  @@index([isActive, displayOrder])
  @@index([createdByAdminId])
}

model VehicleBrand {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @unique @db.VarChar(100)
  slug      String         @unique @db.VarChar(100)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  models    VehicleModel[]
  vehicles  Vehicle[]
}

model VehicleModel {
  id         String   @id @default(uuid()) @db.Uuid
  brandId    String   @db.Uuid
  categoryId String   @db.Uuid
  name       String   @db.VarChar(100)
  slug       String   @db.VarChar(100)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand    VehicleBrand    @relation(fields: [brandId], references: [id])
  category VehicleCategory @relation(fields: [categoryId], references: [id])
  vehicles Vehicle[]
  manufacturerYears ManufacturerYear[]

  @@unique([categoryId, brandId, name])
}

model ManufacturerYear {
  id        String   @id @default(uuid()) @db.Uuid
  modelId   String   @db.Uuid
  year      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model     VehicleModel @relation(fields: [modelId], references: [id])

  @@unique([modelId, year])
}

model Vehicle {
  id                  String                       @id @default(uuid()) @db.Uuid
  categoryId          String?                      @db.Uuid
  brandId             String?                      @db.Uuid
  modelId             String?                      @db.Uuid
  driverId            String?                      @db.Uuid
  registrationNo      String                       @unique @db.VarChar(30)
  make                String                       @db.VarChar(80)
  model               String                       @db.VarChar(80)
  color               String?                      @db.VarChar(40)
  year                Int?
  manufacturerYear    Int?
  seatingCapacity     Int?
  fuelType            String?                      @db.VarChar(40)
  currentAddress      String?
  status              VehicleStatus                @default(PENDING)
  verificationStatus  VehicleVerificationStatus    @default(PENDING)
  isAvailable         Boolean                      @default(false)
  deletedAt           DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  category            VehicleCategory?             @relation(fields: [categoryId], references: [id])
  brand               VehicleBrand?                @relation(fields: [brandId], references: [id])
  vehicleModel        VehicleModel?                @relation(fields: [modelId], references: [id])
  driver              DriverProfile?               @relation("VehicleDriver", fields: [driverId], references: [id])
  documents           VehicleDocument[]
  driverAssignments   DriverVehicleAssignment[]
  dispatchOffers      DispatchOffer[]
  currentBookings     Booking[]                    @relation("CurrentBookingVehicle")
  assignments         DriverAssignment[]
  trips               Trip[]
  statusHistory       VehicleStatusHistory[]
  verificationHistory VehicleVerificationHistory[]
  maintenances        VehicleMaintenance[]
  insurances          VehicleInsurance[]

  @@index([categoryId, status, isAvailable])
  @@index([verificationStatus, status])
}

model VehicleDocument {
  id                      String                  @id @default(uuid()) @db.Uuid
  vehicleId               String                  @db.Uuid
  type                    String                  @db.VarChar(50)
  documentNo              String?                 @db.VarChar(100)
  fileKey                 String
  status                  DocumentStatus          @default(PENDING)
  expiresAt               DateTime?
  verifiedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  vehicle                 Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentStatusHistories DocumentStatusHistory[]
  documentReminders       DocumentReminder[]

  @@unique([vehicleId, type])
  @@index([status, expiresAt])
}

model DriverDocument {
  id                      String                  @id @default(uuid()) @db.Uuid
  driverId                String                  @db.Uuid
  type                    String                  @db.VarChar(50)
  documentNo              String?                 @db.VarChar(100)
  fileKey                 String
  status                  DocumentStatus          @default(PENDING)
  expiresAt               DateTime?
  verifiedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  driver                  DriverProfile           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  documentStatusHistories DocumentStatusHistory[]
  documentReminders       DocumentReminder[]

  @@unique([driverId, type])
  @@index([status, expiresAt])
}

model DriverVehicleAssignment {
  id         String        @id @default(uuid()) @db.Uuid
  driverId   String        @db.Uuid
  vehicleId  String        @db.Uuid
  isActive   Boolean       @default(true)
  assignedAt DateTime      @default(now())
  endedAt    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  driver     DriverProfile @relation(fields: [driverId], references: [id])
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([driverId, isActive])
  @@index([vehicleId, isActive])
}

model Booking {
  id                   String                 @id @default(uuid()) @db.Uuid
  customerId           String                 @db.Uuid
  vehicleCategoryId    String                 @db.Uuid
  type                 BookingType            @default(IMMEDIATE)
  rideType             RideType               @default(CITY)
  tripType             TripType               @default(ONE_WAY)
  tripLeg              TripLeg?
  returnDateTime       DateTime?
  parentBookingId      String?                @db.Uuid
  returnBookingId      String?                @db.Uuid
  status               BookingStatus          @default(PENDING)
  version              Int                    @default(0)
  pickupAddress        String
  pickupLatitude       Decimal                @db.Decimal(10, 7)
  pickupLongitude      Decimal                @db.Decimal(10, 7)
  dropAddress          String
  dropLatitude         Decimal                @db.Decimal(10, 7)
  dropLongitude        Decimal                @db.Decimal(10, 7)
  distanceMeters       Int
  durationSeconds      Int
  routePolyline        String?
  scheduledAt          DateTime?
  couponId             String?                @db.Uuid
  estimatedFare        Decimal                @db.Decimal(12, 2)
  finalFare            Decimal?               @db.Decimal(12, 2)
  currency             String                 @default("INR") @db.Char(3)
  serviceAreaId        String?                @db.Uuid
  assignedDriverId     String?                @db.Uuid
  assignedVehicleId    String?                @db.Uuid
  customerNote         String?
  passengerCount       Int?
  luggageCount         Int?
  bookingFor           Json?
  specialRequirements  String[]
  idempotencyKey       String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  customer             CustomerProfile        @relation(fields: [customerId], references: [id])
  vehicleCategory      VehicleCategory        @relation(fields: [vehicleCategoryId], references: [id])
  coupon               Coupon?                @relation(fields: [couponId], references: [id])
  statusHistory        BookingStatusHistory[]
  scheduledBooking     ScheduledBooking?
  dispatchCycles       DispatchCycle[]
  dispatchOffers       DispatchOffer[]
  trip                 Trip?
  cancellation         BookingCancellation?
  fareBreakdowns       FareBreakdown[]
  payments             Payment[]
  couponUsages         CouponUsage[]
  notifications        Notification[]
  sosRequests          SosRequest[]
  tripShares           TripShare[]
  safetyIncidents      SafetyIncident[]
  supportTickets       SupportTicket[]
  chatMessages         ChatMessage[]
  serviceArea          ServiceArea?           @relation(fields: [serviceAreaId], references: [id])
  assignedDriver       DriverProfile?         @relation("CurrentBookingDriver", fields: [assignedDriverId], references: [id])
  assignedVehicle      Vehicle?               @relation("CurrentBookingVehicle", fields: [assignedVehicleId], references: [id])
  assignments          DriverAssignment[]
  parentBooking        Booking?               @relation("ParentToReturn", fields: [parentBookingId], references: [id])
  returnBookings       Booking[]              @relation("ParentToReturn")
  linkedReturnBooking  Booking?               @relation("ReturnToParent", fields: [returnBookingId], references: [id])
  linkedParentBookings Booking[]              @relation("ReturnToParent")

