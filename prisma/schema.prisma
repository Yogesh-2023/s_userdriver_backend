  bookingId     String              @db.Uuid
  cycleNumber   Int                 @default(1)
  attemptNumber Int                 @default(1)
  radiusMeters  Int
  status        DispatchCycleStatus @default(ACTIVE)
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  failureReason String?             @db.VarChar(100)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offers        DispatchOffer[]

  @@unique([bookingId, cycleNumber])
  @@index([bookingId, status, createdAt])
}

model DispatchOffer {
  id              String              @id @default(uuid()) @db.Uuid
  bookingId       String              @db.Uuid
  dispatchCycleId String              @db.Uuid
  driverId        String              @db.Uuid
  vehicleId       String              @db.Uuid
  attemptNumber   Int
  status          DispatchOfferStatus @default(OFFERED)
  offeredAt       DateTime            @default(now())
  expiresAt       DateTime
  respondedAt     DateTime?
  rejectionReason String?             @db.VarChar(100)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dispatchCycle   DispatchCycle       @relation(fields: [dispatchCycleId], references: [id], onDelete: Cascade)
  driver          DriverProfile       @relation(fields: [driverId], references: [id])
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])
  assignment      DriverAssignment?

  @@unique([dispatchCycleId, driverId])
  @@index([bookingId, status])
  @@index([driverId, status])
  @@index([dispatchCycleId])
}

model DriverAssignment {
  id              String                 @id @default(uuid()) @db.Uuid
  bookingId       String                 @db.Uuid
  driverId        String                 @db.Uuid
  vehicleId       String                 @db.Uuid
  dispatchOfferId String?                @unique @db.Uuid
  batchNo         Int?
  status          DriverAssignmentStatus @default(ACTIVE)
  offeredAt       DateTime               @default(now())
  expiresAt       DateTime?
  respondedAt     DateTime?
  assignedAt      DateTime               @default(now())
  releasedAt      DateTime?
  releaseReason   String?                @db.VarChar(100)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  booking         Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver          DriverProfile          @relation(fields: [driverId], references: [id])
  vehicle         Vehicle                @relation(fields: [vehicleId], references: [id])
  dispatchOffer   DispatchOffer?         @relation(fields: [dispatchOfferId], references: [id])

  @@index([bookingId, status])
  @@index([driverId, status])
  @@index([vehicleId, status])
}

enum SubscriptionDurationType {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
  SCHEDULED
}

enum SubscriptionTripType {
  LIMITED
  UNLIMITED
}

model SubscriptionPlan {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String                   @db.VarChar(100)
  description          String?
  durationType         SubscriptionDurationType
  durationValue        Int
  price                Decimal                  @db.Decimal(12, 2)
  tripType             SubscriptionTripType
  numberOfTrips        Int?
  isActive             Boolean                  @default(true)
  autoRenewAllowed     Boolean                  @default(false)
  gstOrTax             Decimal                  @default(0) @db.Decimal(5, 2)
  applicableCategories VehicleCategory[]
  applicableZones      ServiceZone[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  subscriptions        DriverSubscription[]
}

model DriverSubscription {
  id              String             @id @default(uuid()) @db.Uuid
  driverId        String             @db.Uuid
  planId          String             @db.Uuid
  status          SubscriptionStatus @default(PENDING_PAYMENT)
  startDate       DateTime?
  expiryDate      DateTime?
  priceAtPurchase Decimal            @db.Decimal(12, 2)
  taxAtPurchase   Decimal            @db.Decimal(12, 2)
  remainingTrips  Int?
  autoRenew       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  driver  DriverProfile    @relation(fields: [driverId], references: [id])
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])
  payment Payment?

  @@index([driverId, status])
  @@index([expiryDate])
}

model ChatMessage {
  id         String    @id @default(uuid()) @db.Uuid
  bookingId  String    @db.Uuid
  senderType String    @db.VarChar(20) // CUSTOMER, DRIVER
  senderId   String    @db.Uuid
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model SurgePricingLog {
  id          String      @id @default(uuid()) @db.Uuid
  zoneId      String      @db.Uuid
  multiplier  Decimal     @db.Decimal(4, 2)
  demandScore Int
  supplyScore Int
  createdAt   DateTime    @default(now())
  zone        ServiceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, createdAt])
}

model RentalPackage {
  id                String          @id @default(uuid()) @db.Uuid
  vehicleCategoryId String          @db.Uuid
  name              String          @db.VarChar(100)
  hours             Int
  distanceKm        Int
  basePrice         Decimal         @db.Decimal(12, 2)
  extraKmRate       Decimal         @db.Decimal(12, 2)
  extraHourRate     Decimal         @db.Decimal(12, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  vehicleCategory   VehicleCategory @relation(fields: [vehicleCategoryId], references: [id], onDelete: Cascade)
}

model OutstationPricing {
  id                    String          @id @default(uuid()) @db.Uuid
  vehicleCategoryId     String          @db.Uuid
  roundTripPerKm        Decimal         @db.Decimal(12, 2)
  oneWayPerKm           Decimal         @db.Decimal(12, 2)
  driverAllowancePerDay Decimal         @db.Decimal(12, 2)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  vehicleCategory       VehicleCategory @relation(fields: [vehicleCategoryId], references: [id], onDelete: Cascade)
}

model VehicleMaintenance {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @db.Uuid
  description String
  cost        Decimal  @db.Decimal(10, 2)
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleInsurance {
  id        String    @id @default(uuid()) @db.Uuid
  vehicleId String    @db.Uuid
  provider  String
  policyNo  String
  validFrom DateTime? @db.Date
  expiresAt DateTime  @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}
