{
  "name": "fleet-management-api",
  "version": "0.2.0",
  "private": true,
  "description": "Fastify modular monolith for fleet management and taxi booking",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsup",
    "start": "node dist/main.js",
    "dev": "node --watch --import tsx src/main.ts",
    "start:dev": "node --watch --import tsx src/main.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:api": "npm run test:e2e",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.json --runInBand",
    "test:realtime": "jest --config test/jest-realtime.json --runInBand",
    "test:concurrency": "jest --config test/jest-concurrency.json --runInBand",
    "test:multi-instance": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-multi-instance.json --runInBand",
    "test:load": "node scripts/realtime-load-test.mjs",
    "test:load:prepare": "node scripts/prepare-realtime-load-sessions.mjs",
    "test:watch": "jest --watch",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "postman:generate": "node --import tsx scripts/generate-postman.ts",
    "postman:test:local": "npm run postman:generate && npx newman run docs/postman/Fleet-Management-All-APIs.postman_collection.json",
    "postman:test:customer": "npm run postman:generate && npx newman run docs/postman/Fleet-Management-All-APIs.postman_collection.json --folder \"02 - Customer Authentication\"",
    "postman:test:staging": "npm run postman:generate && npx newman run docs/postman/Fleet-Management-All-APIs.postman_collection.json --env-var baseUrl=https://staging.fleet-taxi.com --env-var socketUrl=wss://staging.fleet-taxi.com"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.58.5",
    "chalk": "^4.1.2",
    "country-state-city": "^3.2.1",
    "fastify": "^5.4.0",
    "fastify-raw-body": "^5.0.0",
    "firebase-admin": "^14.4.0",
    "ioredis": "^5.7.0",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.1",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.2",
    "postman-collection": "^5.3.1",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    }
  },
  "prisma": {
    "seed": "node dist/seed.js"
  }
}
